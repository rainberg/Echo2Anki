OPENAI_API_KEY=

ANKI_PUSH_MODE=direct

ANKI_SYNC_ENDPOINT=http://127.0.0.1:8080
ANKI_SYNC_USERNAME=
ANKI_SYNC_PASSWORD=
ANKI_SYNC_DECK_NAME=Deutsch Listening
ANKI_SYNC_NOTE_TYPE=Basic
ANKI_SYNC_MEDIA_TIMEOUT_SECS=300
ANKI_SYNC_CLIENT_CACHE_DIR=/var/lib/anki-sync-client-push

ANKIWEB_CACHE_DIR=/var/lib/ankiweb-push
ANKIWEB_DECK_NAME=Deutsch Listening
ANKIWEB_NOTE_TYPE=Basic

ANKI_STREAMLIT_TASK_DIR=/var/lib/anki-streamlit/tasks
